---
import { Image } from 'astro:assets';
import benPortrait from '../assets/images/ben-portrait.jpg';
import SectionLabel from './ui/SectionLabel.astro';
import Button from './ui/Button.astro';
---
<section class="relative min-h-screen flex flex-col items-center justify-center px-6 pt-36 pb-20 bg-[#0A0A0A] overflow-hidden">
  <!-- Golden particle wave background -->
  <div
    class="absolute inset-0 pointer-events-none"
    aria-hidden="true"
    style="background: url('/images/gold-particle-wave.jpg') center bottom / cover no-repeat; opacity: 0.3;"
  ></div>
  <!-- Dark overlay to keep text readable -->
  <div
    class="absolute inset-0 pointer-events-none"
    aria-hidden="true"
    style="background: linear-gradient(to bottom, rgba(10,10,10,0.7) 0%, rgba(10,10,10,0.4) 50%, rgba(10,10,10,0.8) 100%);"
  ></div>

  <div class="relative max-w-6xl mx-auto w-full">
    <div class="flex flex-col md:flex-row items-center gap-12 md:gap-16">

      <!-- Left: Text content -->
      <div class="flex-1 text-center md:text-left">
        <!-- Label -->
        <SectionLabel text="AI Agent Installation" mb="mb-6" />

        <!-- h1 -->
        <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight text-[#F0F0F0] leading-tight mb-6">
          Your Business Is<br class="hidden sm:block" />
          Bogged Down by<br class="hidden sm:block" />
          <span class="text-[#C9A84C] gold-text">Busy Work.</span> Let's Fix That.
        </h1>

        <!-- Subheadline -->
        <p class="text-lg md:text-xl text-[#9CA3AF] max-w-2xl md:mx-0 mx-auto mb-5 leading-relaxed">
          We install AI agents and build marketing systems that handle the work your team shouldn't be doing manually. From operations to online presence, we optimize how your business runs and grows.
        </p>

        <!-- Industry callout -->
        <p class="text-[#C9A84C] font-semibold text-base md:text-lg mb-10">
          Built for construction, rental, and event companies.
        </p>

        <!-- CTA -->
        <Button
          variant="gold"
          href="/contact"
          size="lg"
          id="book-call"
          class="focus:ring-offset-[#0A0A0A]"
        >
          Book a Free Discovery Call
        </Button>
      </div>

      <!-- Right: Benjamin's photo -->
      <div class="flex-shrink-0 flex items-center justify-center">
        <div class="relative">
          <!-- Gold glow behind photo -->
          <div
            class="absolute -inset-4 rounded-3xl opacity-20 blur-2xl pointer-events-none"
            style="background: #C9A84C;"
            aria-hidden="true"
          ></div>
          <Image
            src={benPortrait}
            alt="Benjamin Johnstone, founder of Jonroc"
            width={360}
            height={460}
            format="webp"
            quality={85}
            class="relative w-[260px] md:w-[320px] lg:w-[360px] rounded-2xl border-2 border-[#C9A84C]/40 shadow-2xl shadow-black/60 object-cover"
            loading="eager"
          />
          <!-- Name + title -->
          <div class="relative mt-4 text-center">
            <p class="text-[#F0F0F0] font-semibold text-base">Benjamin Johnstone</p>
            <p class="text-[#C9A84C] text-sm tracking-wide">Owner, Jonroc</p>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- Video section -->
  <div class="relative max-w-4xl w-full mx-auto mt-20">

    <!-- Poster / click-to-load state (shown until user clicks play) -->
    <div
      id="video-poster"
      class="w-full aspect-video rounded-2xl border border-white/10 bg-[#111111] flex flex-col items-center justify-center gap-4 cursor-pointer group overflow-hidden relative"
      role="button"
      tabindex="0"
      aria-label="Play founder intro video"
    >
      <!-- Dark gradient overlay on hover -->
      <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-colors duration-300 rounded-2xl" aria-hidden="true"></div>

      <!-- Play button -->
      <div class="relative w-20 h-20 rounded-full border-2 border-[#C9A84C]/60 bg-[#C9A84C]/10 flex items-center justify-center group-hover:border-[#C9A84C] group-hover:bg-[#C9A84C]/20 group-hover:scale-110 transition-all duration-300">
        <svg class="w-8 h-8 text-[#C9A84C] ml-1" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M8 5v14l11-7z" />
        </svg>
      </div>

      <div class="relative text-center">
        <p class="text-[#F0F0F0] font-semibold text-base">Watch the Overview</p>
        <p class="text-[#9CA3AF] text-sm mt-1">AI Co-Partner for Business Operations</p>
      </div>
    </div>

    <!-- Video element (hidden until play is clicked) -->
    <video
      id="hero-video"
      class="hidden w-full aspect-video rounded-2xl border border-white/10 bg-[#0A0A0A]"
      controls
      playsinline
      preload="none"
      aria-label="Founder intro: AI Co-Partner for Business Operations"
    >
      <source data-src="/videos/founder-intro.mp4" type="video/mp4" />
      Your browser does not support the video element.
    </video>

    <!-- Subtle glow under video -->
    <div
      class="absolute -bottom-6 left-1/2 -translate-x-1/2 w-3/4 h-8 blur-2xl opacity-30 pointer-events-none"
      style="background: #C9A84C;"
      aria-hidden="true"
    ></div>
  </div>

  <script>
    const poster = document.getElementById('video-poster');
    const video  = document.getElementById('hero-video') as HTMLVideoElement | null;

    function activateVideo() {
      if (!poster || !video) return;

      // Swap src into the <source> so the browser starts fetching only now
      const source = video.querySelector('source[data-src]') as HTMLSourceElement | null;
      if (source && source.dataset.src) {
        source.src = source.dataset.src;
        delete source.dataset.src;
        video.load();
      }

      // Show video, hide poster
      poster.classList.add('hidden');
      video.classList.remove('hidden');
      video.play().catch(() => {
        // Autoplay blocked — video is visible with controls, user can play manually
      });
    }

    poster?.addEventListener('click', activateVideo);
    poster?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        activateVideo();
      }
    });
  </script>
</section>
