---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  domain: string;
  url: string;
  category: string;
  screenshot: ImageMetadata;
  description1: string;
  description2: string;
}

const { name, domain, url, category, screenshot, description1, description2 } = Astro.props;
---

<article class="bg-[#1A1A1A] border border-white/5 rounded-2xl overflow-hidden hover:border-[#C9A84C]/20 transition-colors duration-300 flex flex-col">

  <!-- Screenshot -->
  <div class="relative overflow-hidden" style="height: 250px; border-bottom: 1px solid rgba(201,168,76,0.2);">
    <Image
      src={screenshot}
      alt={`Screenshot of ${name} website`}
      width={600}
      height={400}
      format="webp"
      quality={82}
      class="w-full h-full object-cover object-top hover:scale-105 transition-transform duration-500"
    />
  </div>

  <!-- Card Content -->
  <div class="p-7 flex flex-col flex-1">
    <div class="flex items-start justify-between gap-3 mb-4">
      <h2 class="text-xl font-bold text-[#F0F0F0] leading-tight">{name}</h2>
      <span class="flex-shrink-0 text-xs font-semibold text-[#C9A84C] border border-[#C9A84C]/30 rounded-full px-3 py-1 bg-[#C9A84C]/5 whitespace-nowrap">
        {category}
      </span>
    </div>

    <p class="text-[#9CA3AF] text-sm leading-relaxed mb-1">{description1}</p>
    <p class="text-[#9CA3AF] text-sm leading-relaxed mb-6">{description2}</p>

    <div class="mt-auto">
      <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block btn-shine border border-[#C9A84C]/50 text-[#C9A84C] font-semibold text-sm px-5 py-2.5 rounded-full hover:bg-[#C9A84C] hover:text-[#0A0A0A] focus:outline-none focus:ring-2 focus:ring-[#C9A84C] focus:ring-offset-2 focus:ring-offset-[#1A1A1A] transition-all duration-200"
      >
        Visit Site
        <span class="sr-only">— {name} ({domain})</span>
      </a>
    </div>
  </div>

</article>
