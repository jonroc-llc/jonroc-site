---
interface Props {
  quote: string;
  name: string;
  context: string;
  source: string;
  stars?: number;
}

const { quote, name, context, source, stars = 5 } = Astro.props;
---

<div class="bg-[#111111] border border-white/5 rounded-2xl p-8 flex flex-col hover:border-[#C9A84C]/20 transition-colors duration-300">
  <!-- Stars -->
  <div class="flex gap-1 mb-5" aria-label={`${stars} out of 5 stars`}>
    {Array.from({ length: stars }).map(() => (
      <svg class="w-4 h-4 text-[#C9A84C] fill-current" viewBox="0 0 20 20" aria-hidden="true">
        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
      </svg>
    ))}
  </div>

  <!-- Quote -->
  <blockquote class="text-[#9CA3AF] leading-relaxed flex-1 mb-6 text-sm">
    {quote}
  </blockquote>

  <!-- Reviewer + Source -->
  <div class="flex items-center justify-between border-t border-white/5 pt-5">
    <div>
      <p class="text-[#F0F0F0] font-semibold text-sm">{name}</p>
      <p class="text-[#9CA3AF] text-xs mt-0.5">{context}</p>
    </div>
    <!-- Source badge -->
    <div class="flex items-center gap-1.5 text-xs text-[#9CA3AF] border border-white/10 rounded-full px-3 py-1">
      {source === 'Facebook' ? (
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="#1877F2" d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.41c0-3.025 1.792-4.697 4.533-4.697 1.312 0 2.686.236 2.686.236v2.97h-1.513c-1.491 0-1.956.93-1.956 1.886v2.267h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z"/>
        </svg>
      ) : (
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
        </svg>
      )}
      {source}
    </div>
  </div>
</div>
