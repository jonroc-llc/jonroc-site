---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTASection from '../components/CTASection.astro';
import SectionLabel from '../components/ui/SectionLabel.astro';
import PortfolioCard from '../components/ui/PortfolioCard.astro';
import imgCalwest from '../assets/images/portfolio/calwest-rentals.jpg';
import imgSiouxFalls from '../assets/images/portfolio/sioux-falls-commercial.jpg';
import imgRentalInnovationz from '../assets/images/portfolio/rental-innovationz.jpg';
import imgRentalWorld from '../assets/images/portfolio/rental-world.jpg';
import imgTlcEvents from '../assets/images/portfolio/tlc-event-rentals.jpg';

const portfolioItems = [
  {
    name: "Cal-West Rentals",
    domain: "calwestrentals.com",
    url: "https://calwestrentals.com",
    category: "Tool & Equipment Rental",
    screenshot: imgCalwest,
    description1: "Full website and online marketing for a California-based tool and equipment rental company.",
    description2: "Built to drive online bookings and local search visibility.",
  },
  {
    name: "Sioux Falls Commercial",
    domain: "siouxfallscommercial.com",
    url: "https://siouxfallscommercial.com",
    category: "Commercial Real Estate",
    screenshot: imgSiouxFalls,
    description1: "Website for a commercial real estate company that builds and manages commercial construction projects for sale.",
    description2: "Features advanced portfolio search functionality to help buyers find and filter available properties.",
  },
  {
    name: "Rental Innovationz",
    domain: "rentalinnovationz.com",
    url: "https://rentalinnovationz.com",
    category: "Event Rental Supply",
    screenshot: imgRentalInnovationz,
    description1: "E-commerce website for an event rental supply company specializing in table and chair bags, tent sidewalls, and accessories for the rental industry.",
    description2: "Built with direct online purchasing so rental companies can order supplies without picking up the phone.",
  },
  {
    name: "Rental World",
    domain: "rentalworld.com",
    url: "https://rentalworld.com",
    category: "Equipment Rental",
    screenshot: imgRentalWorld,
    description1: "Website redesign and SEO for an established equipment rental company.",
    description2: "Focused on improving search visibility and streamlining the customer inquiry process.",
  },
  {
    name: "TLC Event Rentals",
    domain: "tlceventrentals.com",
    url: "https://tlceventrentals.com",
    screenshot: imgTlcEvents,
    category: "Event Rental",
    description1: "Event rental company website with a focus on weddings and corporate events.",
    description2: "Built to showcase inventory and convert browsers into booked clients.",
  },
];
---
<Layout
  title="Portfolio"
  description="Work we've done. Six client websites built for construction companies, rental businesses, and event companies across the country."
>
  <Header />

  <main id="main-content">

    <!-- Intro Section -->
    <section class="relative pt-36 pb-16 px-6 bg-[#0A0A0A]">
      <div
        class="absolute inset-0 pointer-events-none"
        aria-hidden="true"
        style="background: radial-gradient(ellipse 70% 50% at 50% 30%, rgba(201,168,76,0.06) 0%, transparent 70%);"
      ></div>
      <div class="relative max-w-6xl mx-auto">
        <SectionLabel text="Our Work" />
        <h1 class="text-4xl md:text-5xl font-bold text-[#F0F0F0] mb-5 leading-tight">
          Work We've Done
        </h1>
        <p class="text-[#9CA3AF] text-lg max-w-2xl leading-relaxed">
          A selection of websites and online marketing projects built for construction companies, rental businesses, and event companies. Real clients, real results.
        </p>
      </div>
    </section>

    <!-- Portfolio Grid -->
    <section class="py-16 pb-28 px-6 bg-[#0A0A0A]">
      <div class="max-w-6xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
          {portfolioItems.map((item) => (
            <PortfolioCard
              name={item.name}
              domain={item.domain}
              url={item.url}
              category={item.category}
              screenshot={item.screenshot}
              description1={item.description1}
              description2={item.description2}
            />
          ))}
        </div>
      </div>
    </section>
    <!-- CTA -->
    <CTASection
      heading="Want Results Like These"
      headingHighlight="For Your Business?"
      subtext="One conversation. No pitch deck. Just an honest look at your operation and what we can build for you."
      buttonText="Book a Discovery Call"
      footnote="No commitment. No pressure."
    />

  </main>

  <Footer />
</Layout>
